generator client {
  provider            = "prisma-client"
  output              = "../generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model AuditActor {
  id         String   @id @default(uuid()) @db.Uuid
  actor_type String   @db.VarChar(12)
  actor_name String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  created_by String   @db.Uuid
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by String   @db.Uuid
  is_active  Boolean  @default(true)

  created_by_relation AuditActor @relation("audit_actors_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_relation AuditActor @relation("audit_actors_updated_by", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  audit_actors_created_by_rows AuditActor[] @relation("audit_actors_created_by")
  audit_actors_updated_by_rows AuditActor[] @relation("audit_actors_updated_by")

  users_audit_actor_id_rows User? @relation("users_audit_actor_id")
  users_created_by_rows User[] @relation("users_created_by")
  users_updated_by_rows User[] @relation("users_updated_by")

  refresh_sessions_created_by_rows RefreshSession[] @relation("refresh_sessions_created_by")
  refresh_sessions_updated_by_rows RefreshSession[] @relation("refresh_sessions_updated_by")

  password_reset_tokens_created_by_rows PasswordResetToken[] @relation("password_reset_tokens_created_by")
  password_reset_tokens_updated_by_rows PasswordResetToken[] @relation("password_reset_tokens_updated_by")

  hotels_created_by_rows Hotel[] @relation("hotels_created_by")
  hotels_updated_by_rows Hotel[] @relation("hotels_updated_by")

  room_type_master_created_by_rows RoomTypeMaster[] @relation("room_type_master_created_by")
  room_type_master_updated_by_rows RoomTypeMaster[] @relation("room_type_master_updated_by")

  hotel_room_types_created_by_rows HotelRoomType[] @relation("hotel_room_types_created_by")
  hotel_room_types_updated_by_rows HotelRoomType[] @relation("hotel_room_types_updated_by")

  rooms_created_by_rows Room[] @relation("rooms_created_by")
  rooms_updated_by_rows Room[] @relation("rooms_updated_by")

  bookings_created_by_rows Booking[] @relation("bookings_created_by")
  bookings_updated_by_rows Booking[] @relation("bookings_updated_by")

  payment_orders_created_by_rows PaymentOrder[] @relation("payment_orders_created_by")
  payment_orders_updated_by_rows PaymentOrder[] @relation("payment_orders_updated_by")

  payments_created_by_rows Payment[] @relation("payments_created_by")
  payments_updated_by_rows Payment[] @relation("payments_updated_by")

  refunds_created_by_rows Refund[] @relation("refunds_created_by")
  refunds_updated_by_rows Refund[] @relation("refunds_updated_by")

  webhook_events_created_by_rows WebhookEvent[] @relation("webhook_events_created_by")
  webhook_events_updated_by_rows WebhookEvent[] @relation("webhook_events_updated_by")

  email_outbox_created_by_rows EmailOutbox[] @relation("email_outbox_created_by")
  email_outbox_updated_by_rows EmailOutbox[] @relation("email_outbox_updated_by")

  idempotency_records_created_by_rows IdempotencyRecord[] @relation("idempotency_records_created_by")
  idempotency_records_updated_by_rows IdempotencyRecord[] @relation("idempotency_records_updated_by")

  audit_logs_actor_id_rows AuditLog[] @relation("audit_logs_actor_id")
  audit_logs_created_by_rows AuditLog[] @relation("audit_logs_created_by")
  audit_logs_updated_by_rows AuditLog[] @relation("audit_logs_updated_by")

  @@map("audit_actors")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  audit_actor_id String   @unique @db.Uuid
  name           String   @db.VarChar(100)
  email          String   @unique @db.VarChar(254)
  phone          String   @db.VarChar(16)
  password_hash  String   @db.Text
  role           String   @db.VarChar(16)
  created_at     DateTime @default(now()) @db.Timestamptz(3)
  created_by     String   @db.Uuid
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by     String   @db.Uuid
  is_active      Boolean  @default(true)

  audit_actor_relation AuditActor @relation("users_audit_actor_id", fields: [audit_actor_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by_relation AuditActor @relation("users_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_relation AuditActor @relation("users_updated_by", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  refresh_sessions_user_id_rows RefreshSession[] @relation("refresh_sessions_user_id")
  password_reset_tokens_user_id_rows PasswordResetToken[] @relation("password_reset_tokens_user_id")
  hotels_owner_id_rows Hotel[] @relation("hotels_owner_id")
  bookings_customer_id_rows Booking[] @relation("bookings_customer_id")
  email_outbox_recipient_user_id_rows EmailOutbox[] @relation("email_outbox_recipient_user_id")
  idempotency_records_user_id_rows IdempotencyRecord[] @relation("idempotency_records_user_id")

  @@map("users")
}

model RefreshSession {
  id                 String    @id @default(uuid()) @db.Uuid
  user_id            String    @db.Uuid
  family_id          String    @db.Uuid
  token_hash         String    @unique @db.Char(64)
  expires_at         DateTime  @db.Timestamptz(3)
  session_expires_at DateTime  @db.Timestamptz(3)
  revoked_at         DateTime? @db.Timestamptz(3)
  replaced_by_id     String?   @unique @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz(3)
  created_by         String    @db.Uuid
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by         String    @db.Uuid
  is_active          Boolean   @default(true)

  user_relation User @relation("refresh_sessions_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  replaced_by_relation RefreshSession? @relation("refresh_sessions_replaced_by_id", fields: [replaced_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  refresh_sessions_replaced_by_id_rows RefreshSession? @relation("refresh_sessions_replaced_by_id")

  created_by_relation AuditActor @relation("refresh_sessions_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_relation AuditActor @relation("refresh_sessions_updated_by", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([user_id, family_id])
  @@index([expires_at])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.Char(64)
  expires_at DateTime  @db.Timestamptz(3)
  used_at    DateTime? @db.Timestamptz(3)
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  created_by String    @db.Uuid
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by String    @db.Uuid
  is_active  Boolean   @default(true)

  user_relation User @relation("password_reset_tokens_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  created_by_relation AuditActor @relation("password_reset_tokens_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_relation AuditActor @relation("password_reset_tokens_updated_by", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  email_outbox_password_reset_token_id_rows EmailOutbox[] @relation("email_outbox_password_reset_token_id")

  @@index([user_id, expires_at])
  @@map("password_reset_tokens")
}

model Hotel {
  id             String   @id @default(uuid()) @db.Uuid
  owner_id       String   @db.Uuid
  name           String   @db.VarChar(150)
  description    String   @db.VarChar(3000)
  address        String   @db.Text
  city           String   @db.VarChar(100)
  state          String   @db.VarChar(100)
  country_code   String   @db.Char(2)
  postal_code    String   @db.Char(6)
  location       Unsupported("geography(Point,4326)")
  timezone       String   @db.VarChar(64)
  amenities      String[] @default([])
  image_urls     String[] @default([])
  check_in_time  DateTime @db.Time(0)
  check_out_time DateTime @db.Time(0)
  created_at     DateTime @default(now()) @db.Timestamptz(3)
  created_by     String   @db.Uuid
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by     String   @db.Uuid
  is_active      Boolean  @default(true)

  owner_relation User @relation("hotels_owner_id", fields: [owner_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  created_by_relation AuditActor @relation("hotels_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_relation AuditActor @relation("hotels_updated_by", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  hotel_room_types_hotel_id_rows HotelRoomType[] @relation("hotel_room_types_hotel_id")
  rooms_hotel_id_rows Room[] @relation("rooms_hotel_id")
  bookings_hotel_id_rows Booking[] @relation("bookings_hotel_id")

  @@index([owner_id])
  @@index([city])
  @@map("hotels")
}

model RoomTypeMaster {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(30)
  name        String   @unique @db.VarChar(80)
  description String?  @db.VarChar(1000)
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  created_by  String   @db.Uuid
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by  String   @db.Uuid
  is_active   Boolean  @default(true)

  created_by_relation AuditActor @relation("room_type_master_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_relation AuditActor @relation("room_type_master_updated_by", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  hotel_room_types_room_type_master_id_rows HotelRoomType[] @relation("hotel_room_types_room_type_master_id")

  @@map("room_type_master")
}

model HotelRoomType {
  id                  String   @id @default(uuid()) @db.Uuid
  hotel_id            String   @db.Uuid
  room_type_master_id String   @db.Uuid
  description         String   @db.VarChar(2000)
  max_guests          Int      @db.SmallInt
  bed_arrangement     String   @db.VarChar(200)
  amenities           String[] @default([])
  image_urls          String[] @default([])
  price_per_night     BigInt
  currency            String   @db.Char(3)
  created_at          DateTime @default(now()) @db.Timestamptz(3)
  created_by          String   @db.Uuid
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by          String   @db.Uuid
  is_active           Boolean  @default(true)

  hotel_relation Hotel @relation("hotel_room_types_hotel_id", fields: [hotel_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  room_type_master_relation RoomTypeMaster @relation("hotel_room_types_room_type_master_id", fields: [room_type_master_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  created_by_relation AuditActor @relation("hotel_room_types_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_relation AuditActor @relation("hotel_room_types_updated_by", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  rooms_hotel_room_type_id_rows Room[] @relation("rooms_hotel_room_type_id")
  bookings_hotel_room_type_id_rows Booking[] @relation("bookings_hotel_room_type_id")

  @@unique([hotel_id, id])
  @@unique([hotel_id, room_type_master_id])
  @@map("hotel_room_types")
}

model Room {
  id                 String   @id @default(uuid()) @db.Uuid
  hotel_id           String   @db.Uuid
  hotel_room_type_id String   @db.Uuid
  room_number        String   @db.VarChar(20)
  floor              Int      @db.SmallInt
  status             String   @db.VarChar(16)
  created_at         DateTime @default(now()) @db.Timestamptz(3)
  created_by         String   @db.Uuid
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by         String   @db.Uuid
  is_active          Boolean  @default(true)

  hotel_relation Hotel @relation("rooms_hotel_id", fields: [hotel_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  hotel_room_type_relation HotelRoomType @relation("rooms_hotel_room_type_id", fields: [hotel_id, hotel_room_type_id], references: [hotel_id, id], onDelete: Restrict, onUpdate: NoAction)

  created_by_relation AuditActor @relation("rooms_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_relation AuditActor @relation("rooms_updated_by", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  bookings_room_id_rows Booking[] @relation("bookings_room_id")

  @@unique([hotel_id, hotel_room_type_id, id])
  @@unique([hotel_id, room_number])
  @@map("rooms")
}

model Booking {
  id                        String   @id @default(uuid()) @db.Uuid
  reference                 String   @unique @db.VarChar(40)
  customer_id               String   @db.Uuid
  hotel_id                  String   @db.Uuid
  hotel_room_type_id        String   @db.Uuid
  room_id                   String   @db.Uuid
  check_in                  DateTime @db.Date
  check_out                 DateTime @db.Date
  stay_period               Unsupported("daterange") @default(dbgenerated())
  guests                    Int      @db.SmallInt
  guest_name                String   @db.VarChar(100)
  guest_phone               String   @db.VarChar(16)
  special_requests          String?  @db.VarChar(1000)
  hotel_name_snapshot       String   @db.VarChar(150)
  room_type_name_snapshot   String   @db.VarChar(80)
  bed_arrangement_snapshot  String   @db.VarChar(200)
  max_guests_snapshot       Int      @db.SmallInt
  nights                    Int      @default(dbgenerated()) @db.SmallInt
  price_per_night           BigInt
  total_amount              BigInt
  currency                  String   @db.Char(3)
  status                    String   @db.VarChar(24)
  payment_status            String   @db.VarChar(20)
  hold_expires_at           DateTime? @db.Timestamptz(3)
  cancelled_at              DateTime? @db.Timestamptz(3)
  cancellation_reason       String?  @db.VarChar(500)
  checked_in_at             DateTime? @db.Timestamptz(3)
  checked_out_at            DateTime? @db.Timestamptz(3)
  no_show_at                DateTime? @db.Timestamptz(3)
  created_at                DateTime @default(now()) @db.Timestamptz(3)
  created_by                String   @db.Uuid
  updated_at                DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by                String   @db.Uuid
  is_active                 Boolean  @default(true)

  customer_relation User @relation("bookings_customer_id", fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  hotel_relation Hotel @relation("bookings_hotel_id", fields: [hotel_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  hotel_room_type_relation HotelRoomType @relation("bookings_hotel_room_type_id", fields: [hotel_id, hotel_room_type_id], references: [hotel_id, id], onDelete: Restrict, onUpdate: NoAction)

  room_relation Room @relation("bookings_room_id", fields: [hotel_id, hotel_room_type_id, room_id], references: [hotel_id, hotel_room_type_id, id], onDelete: Restrict, onUpdate: NoAction)

  created_by_relation AuditActor @relation("bookings_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_relation AuditActor @relation("bookings_updated_by", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  payment_orders_booking_id_rows PaymentOrder? @relation("payment_orders_booking_id")
  email_outbox_booking_id_rows EmailOutbox[] @relation("email_outbox_booking_id")

  @@index([customer_id, created_at])
  @@index([hotel_id, check_in])
  @@map("bookings")
}

model PaymentOrder {
  id                String    @id @default(uuid()) @db.Uuid
  booking_id        String    @unique @db.Uuid
  razorpay_order_id String?   @unique @db.VarChar(100)
  provider          String    @db.VarChar(16)
  mode              String    @db.VarChar(8)
  amount            BigInt
  currency          String    @db.Char(3)
  creation_status   String    @db.VarChar(16)
  status            String    @db.VarChar(8)
  attempt_count     Int       @default(0)
  next_attempt_at   DateTime? @db.Timestamptz(3)
  locked_until      DateTime? @db.Timestamptz(3)
  last_error_code   String?   @db.VarChar(100)
  reconciled_at     DateTime? @db.Timestamptz(3)
  created_at        DateTime  @default(now()) @db.Timestamptz(3)
  created_by        String    @db.Uuid
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by        String    @db.Uuid
  is_active         Boolean   @default(true)

  booking_relation Booking @relation("payment_orders_booking_id", fields: [booking_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  created_by_relation AuditActor @relation("payment_orders_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_relation AuditActor @relation("payment_orders_updated_by", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  payments_payment_order_id_rows Payment[] @relation("payments_payment_order_id")

  @@map("payment_orders")
}

model Payment {
  id                  String    @id @default(uuid()) @db.Uuid
  payment_order_id    String    @db.Uuid
  razorpay_payment_id String    @unique @db.VarChar(100)
  amount              BigInt
  currency            String    @db.Char(3)
  status              String    @db.VarChar(16)
  failure_code        String?   @db.VarChar(100)
  failure_message     String?   @db.Text
  authorized_at       DateTime? @db.Timestamptz(3)
  captured_at         DateTime? @db.Timestamptz(3)
  verified_at         DateTime? @db.Timestamptz(3)
  booking_applied_at  DateTime? @db.Timestamptz(3)
  created_at          DateTime  @default(now()) @db.Timestamptz(3)
  created_by          String    @db.Uuid
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by          String    @db.Uuid
  is_active           Boolean   @default(true)

  payment_order_relation PaymentOrder @relation("payments_payment_order_id", fields: [payment_order_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  created_by_relation AuditActor @relation("payments_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_relation AuditActor @relation("payments_updated_by", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  refunds_payment_id_rows Refund? @relation("refunds_payment_id")

  @@index([payment_order_id])
  @@map("payments")
}

model Refund {
  id                       String    @id @default(uuid()) @db.Uuid
  payment_id               String    @unique @db.Uuid
  razorpay_refund_id       String?   @unique @db.VarChar(100)
  amount                   BigInt
  currency                 String    @db.Char(3)
  status                   String    @db.VarChar(12)
  reason                   String    @db.VarChar(500)
  attempt_count            Int       @default(0)
  provider_outcome_unknown Boolean   @default(false)
  next_attempt_at          DateTime? @db.Timestamptz(3)
  locked_until             DateTime? @db.Timestamptz(3)
  last_error_code          String?   @db.VarChar(100)
  processed_at             DateTime? @db.Timestamptz(3)
  created_at               DateTime  @default(now()) @db.Timestamptz(3)
  created_by               String    @db.Uuid
  updated_at               DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by               String    @db.Uuid
  is_active                Boolean   @default(true)

  payment_relation Payment @relation("refunds_payment_id", fields: [payment_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  created_by_relation AuditActor @relation("refunds_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_relation AuditActor @relation("refunds_updated_by", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("refunds")
}

model WebhookEvent {
  id                String    @id @default(uuid()) @db.Uuid
  provider_event_id String    @unique @db.VarChar(150)
  event_type        String    @db.VarChar(100)
  payload           Json      @db.JsonB
  payload_hash      String    @db.Char(64)
  status            String    @db.VarChar(16)
  attempt_count     Int       @default(0)
  next_attempt_at   DateTime? @db.Timestamptz(3)
  locked_until      DateTime? @db.Timestamptz(3)
  last_error        String?   @db.Text
  processed_at      DateTime? @db.Timestamptz(3)
  created_at        DateTime  @default(now()) @db.Timestamptz(3)
  created_by        String    @db.Uuid
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by        String    @db.Uuid
  is_active         Boolean   @default(true)

  created_by_relation AuditActor @relation("webhook_events_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_relation AuditActor @relation("webhook_events_updated_by", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("webhook_events")
}

model EmailOutbox {
  id                           String    @id @default(uuid()) @db.Uuid
  recipient_user_id            String?   @db.Uuid
  recipient_email              String    @db.VarChar(254)
  booking_id                   String?   @db.Uuid
  password_reset_token_id      String?   @db.Uuid
  template_code                String    @db.VarChar(50)
  template_version             Int
  template_data                Json      @db.JsonB
  sensitive_payload_ciphertext Bytes?
  encryption_key_id           String?   @db.VarChar(100)
  deduplication_key            String    @unique @db.VarChar(150)
  status                       String    @db.VarChar(16)
  attempt_count                Int       @default(0)
  available_at                 DateTime  @db.Timestamptz(3)
  locked_until                 DateTime? @db.Timestamptz(3)
  provider_message_id          String?   @db.VarChar(150)
  last_error                   String?   @db.Text
  sent_at                      DateTime? @db.Timestamptz(3)
  created_at                   DateTime  @default(now()) @db.Timestamptz(3)
  created_by                   String    @db.Uuid
  updated_at                   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by                   String    @db.Uuid
  is_active                    Boolean   @default(true)

  recipient_user_relation User? @relation("email_outbox_recipient_user_id", fields: [recipient_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  booking_relation Booking? @relation("email_outbox_booking_id", fields: [booking_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  password_reset_token_relation PasswordResetToken? @relation("email_outbox_password_reset_token_id", fields: [password_reset_token_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  created_by_relation AuditActor @relation("email_outbox_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_relation AuditActor @relation("email_outbox_updated_by", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("email_outbox")
}

model IdempotencyRecord {
  id                     String    @id @default(uuid()) @db.Uuid
  user_id                String    @db.Uuid
  operation              String    @db.VarChar(200)
  idempotency_key        String    @db.VarChar(128)
  request_hash           String    @db.Char(64)
  status                 String    @db.VarChar(16)
  response_http_code     Int?      @db.SmallInt
  response_business_body Json?     @db.JsonB
  resource_id            String?   @db.Uuid
  expires_at             DateTime  @db.Timestamptz(3)
  locked_until           DateTime? @db.Timestamptz(3)
  created_at             DateTime  @default(now()) @db.Timestamptz(3)
  created_by             String    @db.Uuid
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by             String    @db.Uuid
  is_active              Boolean   @default(true)

  user_relation User @relation("idempotency_records_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  created_by_relation AuditActor @relation("idempotency_records_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_relation AuditActor @relation("idempotency_records_updated_by", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([user_id, operation, idempotency_key])
  @@index([expires_at])
  @@map("idempotency_records")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actor_id    String   @db.Uuid
  action      String   @db.VarChar(100)
  entity_type String   @db.VarChar(50)
  entity_id   String   @db.Uuid
  changes     Json     @db.JsonB
  request_id  String?  @db.VarChar(100)
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  created_by  String   @db.Uuid
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by  String   @db.Uuid
  is_active   Boolean  @default(true)

  actor_relation AuditActor @relation("audit_logs_actor_id", fields: [actor_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  created_by_relation AuditActor @relation("audit_logs_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_relation AuditActor @relation("audit_logs_updated_by", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([entity_type, entity_id, created_at])
  @@map("audit_logs")
}