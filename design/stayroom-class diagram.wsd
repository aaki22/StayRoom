package "Configuration and Utilities" {

    interface "ILogger" as ILogger <<utils/logger.ts>> {
        +info(message: string, fields: JsonObject): void
        +warn(message: string, fields: JsonObject): void
        +error(message: string, fields: JsonObject): void
    }

    class "Settings" as Settings <<settings.ts>> {
        +port: number
        +databaseUrl: string
        +databasePoolLimit: number
        +jwtSigningSecret: string
        +accessTokenTtlSeconds: number
        +refreshTokenTtlSeconds: number
        +sessionMaxAgeSeconds: number
        +razorpayKeyId: string
        +razorpayKeySecret: string
        +razorpayWebhookSecret: string
        +emailTransport: string
        +encryptionKeyId: string
        +encryptionKey: string
        +jobBatchSize: number
        +jobLeaseSeconds: number
    }

    class "StructuredLogger" as StructuredLogger <<utils/logger.ts>> {
        -sink: LogSink
        +constructor(sink: LogSink)
        +info(message: string, fields: JsonObject): void
        +warn(message: string, fields: JsonObject): void
        +error(message: string, fields: JsonObject): void
    }
}

' Application registration and dependency composition

Server --> App : starts HTTP
Server --> DatabaseClient : closes on shutdown

DependencyRoot ..> ApplicationDependencies : composes
DependencyRoot ..> BackgroundWorker : composes worker process
DependencyRoot ..> DatabaseClient : creates one pool per process
DependencyRoot ..> StructuredLogger : creates
DependencyRoot ..> AuthService : creates
DependencyRoot ..> UserService : creates
DependencyRoot ..> HotelService : creates
DependencyRoot ..> BookingService : creates
DependencyRoot ..> PaymentService : creates
DependencyRoot ..> WebhookService : creates
DependencyRoot ..> RefundService : creates
DependencyRoot ..> AdminService : creates
DependencyRoot ..> NotificationService : creates
DependencyRoot ..> IdempotencyService : creates
DependencyRoot ..> AuditService : creates

App --> HttpMiddleware : registers
App --> ErrorMiddleware : registers after routes
App --> DefaultRoutes : registers directly
App --> AuthRoutes : registers directly
App --> UserRoutes : registers directly
