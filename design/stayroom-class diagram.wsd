@startuml hotel_booking_v1_class_diagram

skinparam classAttributeIconSize 0
skinparam classFontSize 10
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 45
left to right direction

skinparam linetype ortho
skinparam nodesep 100
skinparam ranksep 150
skinparam padding 15

title Hotel Booking v1 — Complete Backend Class Diagram


package "Application and Startup" {

    class "App" as App <<app.ts>> {
        +app: Express
        +constructor(deps: ApplicationDependencies)
        +configureMiddleware(): void
        +configureRoutes(deps: ApplicationDependencies): void
        +configureErrorHandling(): void
    }

    class "Server" as Server <<server.ts>> {
        -app: App
        -dbClient: DatabaseClient
        -httpServer: HttpServer
        +constructor(app: App, dbClient: DatabaseClient)
        +start(): Promise<void>
        +shutdown(): Promise<void>
    }

    class "DependencyRoot" as DependencyRoot <<services/dependencies.ts>> {
        -settings: Settings
        +constructor(settings: Settings)
        +compose(): ApplicationDependencies
        +composeWorker(): BackgroundWorker
    }

    class "ApplicationDependencies" as ApplicationDependencies <<services/dependencies.ts>> {
        +dbClient: DatabaseClient
        +authService: IAuthService
        +userService: IUserService
        +hotelService: IHotelService
        +bookingService: IBookingService
        +paymentService: IPaymentService
        +webhookService: IWebhookService
        +refundService: IRefundService
        +adminService: IAdminService
        +middleware: HttpMiddleware
        +responses: ResponseBuilder
    }

    class "BackgroundWorker" as BackgroundWorker <<worker.ts>> {
        -dbClient: DatabaseClient
        -jobs: IJob[]
        -stopping: boolean
        +constructor(dbClient: DatabaseClient, jobs: IJob[])
        +startJobs(): Promise<void>
        +shutdown(): Promise<void>
    }
}

package "Routes Layer" {

    class "DefaultRoutes" as DefaultRoutes <<routes/default.ts>> {
        -db: DatabaseClient
        -middleware: HttpMiddleware
        -responses: ResponseBuilder
        +router: Router
        +constructor(db: DatabaseClient, middleware: HttpMiddleware, responses: ResponseBuilder)
        +registerRoutes(): void
        +health(req: Request, res: Response, next: NextFunction): Promise<void>
    }

    class "AuthRoutes" as AuthRoutes <<routes/auth_routes.ts>> {
        -service: IAuthService
        -middleware: HttpMiddleware
        -responses: ResponseBuilder
        +router: Router
        +constructor(service: IAuthService, middleware: HttpMiddleware, responses: ResponseBuilder)
        +registerRoutes(): void
        +register(req: Request, res: Response, next: NextFunction): Promise<void>
        +login(req: Request, res: Response, next: NextFunction): Promise<void>
        +refresh(req: Request, res: Response, next: NextFunction): Promise<void>
        +forgotPassword(req: Request, res: Response, next: NextFunction): Promise<void>
        +resetPassword(req: Request, res: Response, next: NextFunction): Promise<void>
        +logout(req: Request, res: Response, next: NextFunction): Promise<void>
    }

    class "UserRoutes" as UserRoutes <<routes/user_routes.ts>> {
        -service: IUserService
        -middleware: HttpMiddleware
        -responses: ResponseBuilder
        +router: Router
        +constructor(service: IUserService, middleware: HttpMiddleware, responses: ResponseBuilder)
        +registerRoutes(): void
        +getProfile(req: Request, res: Response, next: NextFunction): Promise<void>
        +updateProfile(req: Request, res: Response, next: NextFunction): Promise<void>
        +changePassword(req: Request, res: Response, next: NextFunction): Promise<void>
    }

    class "HotelRoutes" as HotelRoutes <<routes/hotel_routes.ts>> {
        -service: IHotelService
        -middleware: HttpMiddleware
        -responses: ResponseBuilder
        +router: Router
        +constructor(service: IHotelService, middleware: HttpMiddleware, responses: ResponseBuilder)
        +registerRoutes(): void
        +searchHotels(req: Request, res: Response, next: NextFunction): Promise<void>
        +getHotelDetails(req: Request, res: Response, next: NextFunction): Promise<void>
        +listRoomTypes(req: Request, res: Response, next: NextFunction): Promise<void>
        +getAvailability(req: Request, res: Response, next: NextFunction): Promise<void>
    }

    class "BookingRoutes" as BookingRoutes <<routes/booking_routes.ts>> {
        -service: IBookingService
        -middleware: HttpMiddleware
        -responses: ResponseBuilder
        +router: Router
        +constructor(service: IBookingService, middleware: HttpMiddleware, responses: ResponseBuilder)
        +registerRoutes(): void
        +createBooking(req: Request, res: Response, next: NextFunction): Promise<void>
        +listMyBookings(req: Request, res: Response, next: NextFunction): Promise<void>
        +getMyBooking(req: Request, res: Response, next: NextFunction): Promise<void>
        +cancelMyBooking(req: Request, res: Response, next: NextFunction): Promise<void>
    }

    class "PaymentRoutes" as PaymentRoutes <<routes/payment_routes.ts>> {
        -service: IPaymentService
        -webhooks: IWebhookService
        -middleware: HttpMiddleware
        -responses: ResponseBuilder
        +router: Router
        +constructor(service: IPaymentService, webhooks: IWebhookService, middleware: HttpMiddleware, responses: ResponseBuilder)
        +registerRoutes(): void
        +createPaymentOrder(req: Request, res: Response, next: NextFunction): Promise<void>
        +verifyCheckout(req: Request, res: Response, next: NextFunction): Promise<void>
        +listPayments(req: Request, res: Response, next: NextFunction): Promise<void>
        +handleWebhook(req: Request, res: Response, next: NextFunction): Promise<void>
    }

    class "RefundRoutes" as RefundRoutes <<routes/refund_routes.ts>> {
        -service: IRefundService
        -middleware: HttpMiddleware
        -responses: ResponseBuilder
        +router: Router
        +constructor(service: IRefundService, middleware: HttpMiddleware, responses: ResponseBuilder)
        +registerRoutes(): void
        +listBookingRefunds(req: Request, res: Response, next: NextFunction): Promise<void>
    }

    class "AdminRoutes" as AdminRoutes <<routes/admin_routes.ts>> {
        -service: IAdminService
        -middleware: HttpMiddleware
        -responses: ResponseBuilder
        +router: Router
        +constructor(service: IAdminService, middleware: HttpMiddleware, responses: ResponseBuilder)
        +registerRoutes(): void
        +listHotels(req: Request, res: Response, next: NextFunction): Promise<void>
        +createHotel(req: Request, res: Response, next: NextFunction): Promise<void>
        +getHotel(req: Request, res: Response, next: NextFunction): Promise<void>
        +patchHotel(req: Request, res: Response, next: NextFunction): Promise<void>
        +listRoomTypes(req: Request, res: Response, next: NextFunction): Promise<void>
        +createRoomType(req: Request, res: Response, next: NextFunction): Promise<void>
        +getRoomType(req: Request, res: Response, next: NextFunction): Promise<void>
        +patchRoomType(req: Request, res: Response, next: NextFunction): Promise<void>
        +listRooms(req: Request, res: Response, next: NextFunction): Promise<void>
        +createRoom(req: Request, res: Response, next: NextFunction): Promise<void>
        +getRoom(req: Request, res: Response, next: NextFunction): Promise<void>
        +patchRoom(req: Request, res: Response, next: NextFunction): Promise<void>
        +listBookings(req: Request, res: Response, next: NextFunction): Promise<void>
        +getBooking(req: Request, res: Response, next: NextFunction): Promise<void>
        +cancelBooking(req: Request, res: Response, next: NextFunction): Promise<void>
        +executeCheckIn(req: Request, res: Response, next: NextFunction): Promise<void>
        +executeCheckOut(req: Request, res: Response, next: NextFunction): Promise<void>
        +markNoShow(req: Request, res: Response, next: NextFunction): Promise<void>
        +listRefunds(req: Request, res: Response, next: NextFunction): Promise<void>
        +getRefund(req: Request, res: Response, next: NextFunction): Promise<void>
        +retryRefund(req: Request, res: Response, next: NextFunction): Promise<void>
    }
}

package "Middleware Layer" {

    class "HttpMiddleware" as HttpMiddleware <<middleware/http_middleware.ts>> {
        +auth: AuthMiddleware
        +validation: ValidationMiddleware
        +rawBody: RawBodyMiddleware
        +errors: ErrorMiddleware
        +context: RequestContextMiddleware
    }

    class "AuthMiddleware" as AuthMiddleware <<middleware/auth.ts>> {
        -tokens: ITokenClient
        -users: IUserRepository
        +constructor(tokens: ITokenClient, users: IUserRepository)
        +authenticate(req: Request, res: Response, next: NextFunction): Promise<void>
        +requireRole(roles: UserRole[]): RequestHandler
    }

    class "ValidationMiddleware" as ValidationMiddleware <<middleware/validation.ts>> {
        +validateSchema<T>(schema: RequestSchema<T>): RequestHandler
    }

    class "RawBodyMiddleware" as RawBodyMiddleware <<middleware/raw_body.ts>> {
        +captureRawBody(): RequestHandler
    }

    class "RequestContextMiddleware" as RequestContextMiddleware <<middleware/request_context.ts>> {
        +attach(req: Request, res: Response, next: NextFunction): void
    }

    class "ErrorMiddleware" as ErrorMiddleware <<middleware/error_handler.ts>> {
        -responses: ResponseBuilder
        -logger: ILogger
        +constructor(responses: ResponseBuilder, logger: ILogger)
        +handleError(err: unknown, req: Request, res: Response, next: NextFunction): void
        +notFound(req: Request, res: Response): void
    }
}

package "Service Layer" {

    interface "IAuthService" as IAuthService <<services/auth_service.ts>> {
        +register(dto: RegisterInputDTO, ctx: RequestContext): Promise<AuthResultDTO>
        +login(dto: LoginInputDTO, ctx: RequestContext): Promise<AuthResultDTO>
        +refresh(dto: RefreshInputDTO, ctx: RequestContext): Promise<TokensDTO>
        +forgotPassword(dto: ForgotPasswordInputDTO, ctx: RequestContext): Promise<void>
        +resetPassword(dto: ResetPasswordInputDTO, ctx: RequestContext): Promise<void>
        +logout(dto: RefreshInputDTO, ctx: RequestContext): Promise<void>
    }

    class "AuthService" as AuthService <<services/auth_service.ts>> {
        -users: IUserRepository
        -sessions: ISessionRepository
        -resets: IPasswordResetRepository
        -actors: IAuditActorRepository
        -tokens: ITokenClient
        -passwords: IPasswordClient
        -notifications: INotificationService
        -audit: IAuditService
        -db: DatabaseClient
        +constructor(users: IUserRepository, sessions: ISessionRepository, resets: IPasswordResetRepository, actors: IAuditActorRepository, tokens: ITokenClient, passwords: IPasswordClient, notifications: INotificationService, audit: IAuditService, db: DatabaseClient)
    }

    interface "IUserService" as IUserService <<services/user_service.ts>> {
        +getProfile(ctx: RequestContext): Promise<UserDTO>
        +updateProfile(dto: ProfileUpdateDTO, ctx: RequestContext): Promise<UserDTO>
        +changePassword(dto: PasswordChangeDTO, ctx: RequestContext): Promise<void>
    }

    class "UserService" as UserService <<services/user_service.ts>> {
        -users: IUserRepository
        -sessions: ISessionRepository
        -passwords: IPasswordClient
        -audit: IAuditService
        -db: DatabaseClient
        +constructor(users: IUserRepository, sessions: ISessionRepository, passwords: IPasswordClient, audit: IAuditService, db: DatabaseClient)
    }

    interface "IHotelService" as IHotelService <<services/hotel_service.ts>> {
        +searchHotels(q: HotelSearchQueryDTO): Promise<PageDTO<HotelSearchItemDTO>>
        +getHotelDetails(hotelId: UUID): Promise<HotelDTO>
        +listPublicRoomTypes(hotelId: UUID, q: PaginationQueryDTO): Promise<PageDTO<RoomTypeDTO>>
        +getAvailability(hotelId: UUID, q: AvailabilityCriteriaDTO): Promise<PageDTO<AvailabilityItemDTO>>
        +listHotels(q: AdminHotelQueryDTO, ctx: RequestContext): Promise<PageDTO<HotelDTO>>
        +createHotel(dto: HotelInputDTO, ctx: RequestContext): Promise<HotelDTO>
        +getHotel(hotelId: UUID, ctx: RequestContext): Promise<HotelDTO>
        +patchHotel(hotelId: UUID, dto: HotelPatchDTO, ctx: RequestContext): Promise<HotelDTO>
        +listRoomTypes(hotelId: UUID, q: PaginationQueryDTO, ctx: RequestContext): Promise<PageDTO<RoomTypeDTO>>
        +createRoomType(hotelId: UUID, dto: RoomTypeInputDTO, ctx: RequestContext): Promise<RoomTypeDTO>
        +getRoomType(hotelId: UUID, roomTypeId: UUID, ctx: RequestContext): Promise<RoomTypeDTO>
        +patchRoomType(hotelId: UUID, roomTypeId: UUID, dto: RoomTypePatchDTO, ctx: RequestContext): Promise<RoomTypeDTO>
        +listRooms(hotelId: UUID, q: PaginationQueryDTO, ctx: RequestContext): Promise<PageDTO<RoomDTO>>
        +createRoom(hotelId: UUID, dto: RoomInputDTO, ctx: RequestContext): Promise<RoomDTO>
        +getRoom(hotelId: UUID, roomId: UUID, ctx: RequestContext): Promise<RoomDTO>
        +patchRoom(hotelId: UUID, roomId: UUID, dto: RoomPatchDTO, ctx: RequestContext): Promise<RoomDTO>
    }

    class "HotelService" as HotelService <<services/hotel_service.ts>> {
        -hotels: IHotelRepository
        -inventory: IInventoryRepository
        -bookings: IBookingRepository
        -audit: IAuditService
        -db: DatabaseClient
        +constructor(hotels: IHotelRepository, inventory: IInventoryRepository, bookings: IBookingRepository, audit: IAuditService, db: DatabaseClient)
    }

    interface "IAdminService" as IAdminService <<services/admin_service.ts>> {
        +listHotels(q: AdminHotelQueryDTO, ctx: RequestContext): Promise<PageDTO<HotelDTO>>
        +createHotel(dto: HotelInputDTO, ctx: RequestContext): Promise<HotelDTO>
        +getHotel(hotelId: UUID, ctx: RequestContext): Promise<HotelDTO>
        +patchHotel(hotelId: UUID, dto: HotelPatchDTO, ctx: RequestContext): Promise<HotelDTO>
        +listRoomTypes(hotelId: UUID, q: PaginationQueryDTO, ctx: RequestContext): Promise<PageDTO<RoomTypeDTO>>
        +createRoomType(hotelId: UUID, dto: RoomTypeInputDTO, ctx: RequestContext): Promise<RoomTypeDTO>
        +getRoomType(hotelId: UUID, roomTypeId: UUID, ctx: RequestContext): Promise<RoomTypeDTO>
        +patchRoomType(hotelId: UUID, roomTypeId: UUID, dto: RoomTypePatchDTO, ctx: RequestContext): Promise<RoomTypeDTO>
        +listRooms(hotelId: UUID, q: PaginationQueryDTO, ctx: RequestContext): Promise<PageDTO<RoomDTO>>
        +createRoom(hotelId: UUID, dto: RoomInputDTO, ctx: RequestContext): Promise<RoomDTO>
        +getRoom(hotelId: UUID, roomId: UUID, ctx: RequestContext): Promise<RoomDTO>
        +patchRoom(hotelId: UUID, roomId: UUID, dto: RoomPatchDTO, ctx: RequestContext): Promise<RoomDTO>
        +listBookings(q: AdminBookingQueryDTO, ctx: RequestContext): Promise<PageDTO<AdminBookingDTO>>
        +getBooking(bookingId: UUID, ctx: RequestContext): Promise<AdminBookingDTO>
        +cancelBooking(bookingId: UUID, dto: CancelInputDTO, key: string, ctx: RequestContext): Promise<CancelResultDTO>
        +executeCheckIn(bookingId: UUID, key: string, ctx: RequestContext): Promise<AdminBookingDTO>
        +executeCheckOut(bookingId: UUID, key: string, ctx: RequestContext): Promise<AdminBookingDTO>
        +markNoShow(bookingId: UUID, key: string, ctx: RequestContext): Promise<AdminBookingDTO>
        +listRefunds(q: RefundQueryDTO, ctx: RequestContext): Promise<PageDTO<RefundDTO>>
        +getRefund(refundId: UUID, ctx: RequestContext): Promise<RefundDTO>
        +retryRefund(refundId: UUID, key: string, ctx: RequestContext): Promise<RefundDTO>
    }

    class "AdminService" as AdminService <<services/admin_service.ts>> {
        -hotels: IHotelService
        -bookings: IBookingService
        -refunds: IRefundService
        +constructor(hotels: IHotelService, bookings: IBookingService, refunds: IRefundService)
    }

    interface "IBookingService" as IBookingService <<services/booking_service.ts>> {
        +initiateBooking(dto: BookingInputDTO, key: string, ctx: RequestContext): Promise<BookingDTO>
        +listMyBookings(q: BookingQueryDTO, ctx: RequestContext): Promise<PageDTO<BookingDTO>>
        +getMyBooking(bookingId: UUID, ctx: RequestContext): Promise<BookingDTO>
        +cancelBooking(bookingId: UUID, dto: CancelInputDTO, key: string, ctx: RequestContext): Promise<CancelResultDTO>
        +listBookings(q: AdminBookingQueryDTO, ctx: RequestContext): Promise<PageDTO<AdminBookingDTO>>
        +getBooking(bookingId: UUID, ctx: RequestContext): Promise<AdminBookingDTO>
        +executeCheckIn(bookingId: UUID, key: string, ctx: RequestContext): Promise<AdminBookingDTO>
        +executeCheckOut(bookingId: UUID, key: string, ctx: RequestContext): Promise<AdminBookingDTO>
        +markNoShow(bookingId: UUID, key: string, ctx: RequestContext): Promise<AdminBookingDTO>
        +expireHolds(limit: number, ctx: RequestContext): Promise<number>
    }

    class "BookingService" as BookingService <<services/booking_service.ts>> {
        -bookings: IBookingRepository
        -hotels: IHotelRepository
        -inventory: IInventoryRepository
        -idempotency: IIdempotencyService
        -refunds: IRefundService
        -notifications: INotificationService
        -audit: IAuditService
        -db: DatabaseClient
        -transitions: BookingTransitions
        +constructor(bookings: IBookingRepository, hotels: IHotelRepository, inventory: IInventoryRepository, idempotency: IIdempotencyService, refunds: IRefundService, notifications: INotificationService, audit: IAuditService, db: DatabaseClient, transitions: BookingTransitions)
    }

    interface "IPaymentService" as IPaymentService <<services/payment_service.ts>> {
        +createOrRetrieveOrder(bookingId: UUID, key: string, ctx: RequestContext): Promise<PaymentOrderDTO>
        +verifyClientCheckout(bookingId: UUID, dto: PaymentVerifyInputDTO, ctx: RequestContext): Promise<VerificationOutcome>
        +listPayments(bookingId: UUID, q: PaginationQueryDTO, ctx: RequestContext): Promise<PageDTO<PaymentDTO>>
        +reconcilePending(limit: number, ctx: RequestContext): Promise<number>
    }

    class "PaymentService" as PaymentService <<services/payment_service.ts>> {
        -payments: IPaymentRepository
        -bookings: IBookingRepository
        -adapter: IPaymentAdapter
        -idempotency: IIdempotencyService
        -capture: CaptureProcessor
        -db: DatabaseClient
        +constructor(payments: IPaymentRepository, bookings: IBookingRepository, adapter: IPaymentAdapter, idempotency: IIdempotencyService, capture: CaptureProcessor, db: DatabaseClient)
    }

    class "CaptureProcessor" as CaptureProcessor <<services/capture_processor.ts>> {
        -payments: IPaymentRepository
        -bookings: IBookingRepository
        -transitions: BookingTransitions
        -refunds: IRefundService
        -notifications: INotificationService
        -audit: IAuditService
        +constructor(payments: IPaymentRepository, bookings: IBookingRepository, transitions: BookingTransitions, refunds: IRefundService, notifications: INotificationService, audit: IAuditService)
        +apply(capture: VerifiedCapture, ctx: RequestContext, tx: TransactionContext): Promise<void>
    }

    interface "IWebhookService" as IWebhookService <<services/webhook_service.ts>> {
        +processWebhook(eventId: string, signature: string, rawPayload: Buffer, ctx: RequestContext): Promise<void>
        +processPending(limit: number, ctx: RequestContext): Promise<number>
    }

    class "WebhookService" as WebhookService <<services/webhook_service.ts>> {
        -inbox: IWebhookRepository
        -adapter: IPaymentAdapter
        -capture: CaptureProcessor
        -refunds: IRefundService
        -db: DatabaseClient
        +constructor(inbox: IWebhookRepository, adapter: IPaymentAdapter, capture: CaptureProcessor, refunds: IRefundService, db: DatabaseClient)
    }

    interface "IRefundService" as IRefundService <<services/refund_service.ts>> {
        +listBookingRefunds(bookingId: UUID, q: PaginationQueryDTO, ctx: RequestContext): Promise<PageDTO<RefundDTO>>
        +listRefunds(q: RefundQueryDTO, ctx: RequestContext): Promise<PageDTO<RefundDTO>>
        +getRefund(refundId: UUID, ctx: RequestContext): Promise<RefundDTO>
        +retryRefund(refundId: UUID, key: string, ctx: RequestContext): Promise<RefundDTO>
        +enqueueFullRefund(paymentId: UUID, reason: string, ctx: RequestContext, tx: TransactionContext): Promise<refunds>
        +applyProviderRefund(refund: ProviderRefund, ctx: RequestContext, tx: TransactionContext): Promise<void>
        +processPending(limit: number, ctx: RequestContext): Promise<number>
        +reconcilePending(limit: number, ctx: RequestContext): Promise<number>
    }

    class "RefundService" as RefundService <<services/refund_service.ts>> {
        -refunds: IRefundRepository
        -payments: IPaymentRepository
        -bookings: IBookingRepository
        -adapter: IPaymentAdapter
        -idempotency: IIdempotencyService
        -notifications: INotificationService
        -audit: IAuditService
        -db: DatabaseClient
        +constructor(refunds: IRefundRepository, payments: IPaymentRepository, bookings: IBookingRepository, adapter: IPaymentAdapter, idempotency: IIdempotencyService, notifications: INotificationService, audit: IAuditService, db: DatabaseClient)
    }

    interface "INotificationService" as INotificationService <<services/notification_service.ts>> {
        +enqueue(message: NotificationInput, ctx: RequestContext, tx: TransactionContext): Promise<void>
        +deliverPending(limit: number, ctx: RequestContext): Promise<number>
    }

    class "NotificationService" as NotificationService <<services/notification_service.ts>> {
        -outbox: IEmailOutboxRepository
        -email: IEmailClient
        -cipher: IPayloadCipherClient
        -templates: EmailTemplateRenderer
        -db: DatabaseClient
        +constructor(outbox: IEmailOutboxRepository, email: IEmailClient, cipher: IPayloadCipherClient, templates: EmailTemplateRenderer, db: DatabaseClient)
    }

    interface "IIdempotencyService" as IIdempotencyService <<services/idempotency_service.ts>> {
        +claim<T>(scope: IdempotencyScope, key: string, hash: string, ctx: RequestContext, tx: TransactionContext): Promise<ClaimResult<T>>
        +complete<T>(id: UUID, result: StoredOutcome<T>, ctx: RequestContext, tx: TransactionContext): Promise<void>
    }

    class "IdempotencyService" as IdempotencyService <<services/idempotency_service.ts>> {
        -records: IIdempotencyRepository
        +constructor(records: IIdempotencyRepository)
        +claim<T>(scope: IdempotencyScope, key: string, hash: string, ctx: RequestContext, tx: TransactionContext): Promise<ClaimResult<T>>
        +complete<T>(id: UUID, result: StoredOutcome<T>, ctx: RequestContext, tx: TransactionContext): Promise<void>
    }

    interface "IAuditService" as IAuditService <<services/audit_service.ts>> {
        +record(event: AuditEvent, ctx: RequestContext, tx: TransactionContext): Promise<void>
    }

    class "AuditService" as AuditService <<services/audit_service.ts>> {
        -logs: IAuditRepository
        +constructor(logs: IAuditRepository)
    }
}

package "Repository Layer" {

    interface "IUserRepository" as IUserRepository <<repositories/user_repository.ts>> {
        +findByEmail(email: string): Promise<users | null>
        +findById(id: UUID): Promise<users | null>
        +insert(user: users, tx: TransactionContext): Promise<void>
        +update(user: users, ctx: RequestContext, tx: TransactionContext): Promise<void>
    }

    class "UserRepository" as UserRepository <<repositories/user_repository.ts>> {
        -db: DatabaseClient
        +constructor(db: DatabaseClient)
    }

    interface "IAuditActorRepository" as IAuditActorRepository <<repositories/audit_actor_repository.ts>> {
        +insert(actor: audit_actors, tx: TransactionContext): Promise<void>
    }

    class "AuditActorRepository" as AuditActorRepository <<repositories/audit_actor_repository.ts>> {
        -db: DatabaseClient
        +constructor(db: DatabaseClient)
    }

    interface "ISessionRepository" as ISessionRepository <<repositories/session_repository.ts>> {
        +lockByHash(hash: string, tx: TransactionContext): Promise<refresh_sessions | null>
        +insert(session: refresh_sessions, tx: TransactionContext): Promise<void>
        +rotate(currentId: UUID, next: refresh_sessions, ctx: RequestContext, tx: TransactionContext): Promise<void>
        +revokeFamily(familyId: UUID, ctx: RequestContext, tx: TransactionContext): Promise<void>
        +revokeAll(userId: UUID, ctx: RequestContext, tx: TransactionContext): Promise<void>
    }

    class "SessionRepository" as SessionRepository <<repositories/session_repository.ts>> {
        -db: DatabaseClient
        +constructor(db: DatabaseClient)
    }

    interface "IPasswordResetRepository" as IPasswordResetRepository <<repositories/password_reset_repository.ts>> {
        +lockByHash(hash: string, tx: TransactionContext): Promise<password_reset_tokens | null>
        +insert(token: password_reset_tokens, tx: TransactionContext): Promise<void>
        +consume(id: UUID, ctx: RequestContext, tx: TransactionContext): Promise<void>
    }

    class "PasswordResetRepository" as PasswordResetRepository <<repositories/password_reset_repository.ts>> {
        -db: DatabaseClient
        +constructor(db: DatabaseClient)
    }

    interface "IHotelRepository" as IHotelRepository <<repositories/hotel_repository.ts>> {
        +search(q: HotelSearchQueryDTO): Promise<PageDTO<HotelSearchItemDTO>>
        +findById(id: UUID): Promise<hotels | null>
        +listOwned(q: AdminHotelQueryDTO, ownerId: UUID): Promise<PageDTO<HotelDTO>>
        +lockOwned(id: UUID, ownerId: UUID, tx: TransactionContext): Promise<hotels>
        +insert(hotel: hotels, tx: TransactionContext): Promise<void>
        +update(hotel: hotels, ctx: RequestContext, tx: TransactionContext): Promise<void>
    }

    class "HotelRepository" as HotelRepository <<repositories/hotel_repository.ts>> {
        -db: DatabaseClient
        +constructor(db: DatabaseClient)
    }

    interface "IInventoryRepository" as IInventoryRepository <<repositories/inventory_repository.ts>> {
