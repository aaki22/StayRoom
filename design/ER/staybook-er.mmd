erDiagram
    direction TB
    %% Display columns: NAME | DATA TYPE | KEY CONSTRAINTS | OTHER CONSTRAINTS.
    %% Native ER attribute slots are intentionally used in display order: name first, data type second.
    %% VARCHAR and CHAR lengths are shown in the constraint column. TEXT_ARRAY means PostgreSQL TEXT[].
    %% All five audit fields are independent columns; created_by and updated_by reference audit_actors.id.
    %% Repeated audit FK arrows omitted to keep the ER readable. Money amounts use INR paise.

    audit_actors {
        id UUID PK "NOT NULL"
        actor_type VARCHAR "length 12; NOT NULL"
        actor_name VARCHAR "length 100; NOT NULL"
        created_at TIMESTAMPTZ "NOT NULL"
        created_by UUID FK "NOT NULL; references audit_actors.id"
        updated_at TIMESTAMPTZ "NOT NULL"
        updated_by UUID FK "NOT NULL; references audit_actors.id"
        is_active BOOLEAN "NOT NULL; default TRUE"
    }

    users {
        id UUID PK "NOT NULL"
        audit_actor_id UUID FK, UK "NOT NULL; references audit_actors.id"
        name VARCHAR "length 100; NOT NULL"
        email VARCHAR UK "length 254; NOT NULL"
        phone VARCHAR "length 16; NOT NULL"
        password_hash TEXT "NOT NULL"
        role VARCHAR "length 16; NOT NULL"
        created_at TIMESTAMPTZ "NOT NULL"
        created_by UUID FK "NOT NULL; references audit_actors.id"
        updated_at TIMESTAMPTZ "NOT NULL"
        updated_by UUID FK "NOT NULL; references audit_actors.id"
        is_active BOOLEAN "NOT NULL; default TRUE"
    }

    refresh_sessions {
        id UUID PK "NOT NULL"
        user_id UUID FK "NOT NULL; references users.id"
        family_id UUID "NOT NULL; rotation_group"
        token_hash CHAR UK "length 64; NOT NULL"
        expires_at TIMESTAMPTZ "NOT NULL"
        session_expires_at TIMESTAMPTZ "NOT NULL"
        revoked_at TIMESTAMPTZ "NULL"
        replaced_by_id UUID FK, UK "NULL; references refresh_sessions.id"
        created_at TIMESTAMPTZ "NOT NULL"
        created_by UUID FK "NOT NULL; references audit_actors.id"
        updated_at TIMESTAMPTZ "NOT NULL"
        updated_by UUID FK "NOT NULL; references audit_actors.id"
        is_active BOOLEAN "NOT NULL; default TRUE"
    }

    password_reset_tokens {
        id UUID PK "NOT NULL"
        user_id UUID FK "NOT NULL; references users.id"
        token_hash CHAR UK "length 64; NOT NULL"
        expires_at TIMESTAMPTZ "NOT NULL"
        used_at TIMESTAMPTZ "NULL"
        created_at TIMESTAMPTZ "NOT NULL"
        created_by UUID FK "NOT NULL; references audit_actors.id"
        updated_at TIMESTAMPTZ "NOT NULL"
        updated_by UUID FK "NOT NULL; references audit_actors.id"
        is_active BOOLEAN "NOT NULL; default TRUE"
    }

    hotels {
        id UUID PK "NOT NULL"
        owner_id UUID FK "NOT NULL; references users.id"
        name VARCHAR "length 150; NOT NULL"
        description VARCHAR "length 3000; NOT NULL"
        address TEXT "NOT NULL"
        city VARCHAR "length 100; NOT NULL"
        state VARCHAR "length 100; NOT NULL"
        country_code CHAR "length 2; NOT NULL"
        postal_code CHAR "length 6; NOT NULL"
        location GEOGRAPHY "POINT; SRID 4326; NOT NULL"
        timezone VARCHAR "length 64; NOT NULL"
        amenities TEXT_ARRAY "NOT NULL"
        image_urls TEXT_ARRAY "NOT NULL"
        check_in_time TIME "NOT NULL"
        check_out_time TIME "NOT NULL"
        created_at TIMESTAMPTZ "NOT NULL"
        created_by UUID FK "NOT NULL; references audit_actors.id"
        updated_at TIMESTAMPTZ "NOT NULL"
        updated_by UUID FK "NOT NULL; references audit_actors.id"
        is_active BOOLEAN "NOT NULL; default TRUE"
    }

    room_type_master {
        id UUID PK "NOT NULL"
        code VARCHAR UK "length 30; NOT NULL"
        name VARCHAR UK "length 80; NOT NULL"
        description VARCHAR "length 1000; NULL"
        created_at TIMESTAMPTZ "NOT NULL"
        created_by UUID FK "NOT NULL; references audit_actors.id"
        updated_at TIMESTAMPTZ "NOT NULL"
        updated_by UUID FK "NOT NULL; references audit_actors.id"
        is_active BOOLEAN "NOT NULL; default TRUE"
    }

    hotel_room_types {
        id UUID PK "NOT NULL"
        hotel_id UUID FK "NOT NULL; references hotels.id"
        room_type_master_id UUID FK "NOT NULL; references room_type_master.id"
        description VARCHAR "length 2000; NOT NULL"
        max_guests SMALLINT "NOT NULL"
        bed_arrangement VARCHAR "length 200; NOT NULL"
        amenities TEXT_ARRAY "NOT NULL"
        image_urls TEXT_ARRAY "NOT NULL"
        price_per_night BIGINT "NOT NULL"
        currency CHAR "length 3; NOT NULL"
        created_at TIMESTAMPTZ "NOT NULL"
        created_by UUID FK "NOT NULL; references audit_actors.id"
        updated_at TIMESTAMPTZ "NOT NULL"
        updated_by UUID FK "NOT NULL; references audit_actors.id"
        is_active BOOLEAN "NOT NULL; default TRUE"
    }

    rooms {
        id UUID PK "NOT NULL"
        hotel_id UUID FK "NOT NULL; references hotels.id"
        hotel_room_type_id UUID FK "NOT NULL; references hotel_room_types.id"
        room_number VARCHAR "length 20; NOT NULL"
        floor SMALLINT "NOT NULL"
        status VARCHAR "length 16; NOT NULL"
        created_at TIMESTAMPTZ "NOT NULL"
        created_by UUID FK "NOT NULL; references audit_actors.id"
        updated_at TIMESTAMPTZ "NOT NULL"
        updated_by UUID FK "NOT NULL; references audit_actors.id"
        is_active BOOLEAN "NOT NULL; default TRUE"
    }

    bookings {
        id UUID PK "NOT NULL"
        reference VARCHAR UK "length 40; NOT NULL"
        customer_id UUID FK "NOT NULL; references users.id"
        hotel_id UUID FK "NOT NULL; references hotels.id"
        hotel_room_type_id UUID FK "NOT NULL; references hotel_room_types.id"
        room_id UUID FK "NOT NULL; references rooms.id"
        check_in DATE "NOT NULL"
        check_out DATE "NOT NULL"
        stay_period DATERANGE "GEN; NOT NULL"
        guests SMALLINT "NOT NULL"
        guest_name VARCHAR "length 100; NOT NULL"
        guest_phone VARCHAR "length 16; NOT NULL"
        special_requests VARCHAR "length 1000; NULL"
        hotel_name_snapshot VARCHAR "length 150; NOT NULL"
        room_type_name_snapshot VARCHAR "length 80; NOT NULL"
        bed_arrangement_snapshot VARCHAR "length 200; NOT NULL"
        max_guests_snapshot SMALLINT "NOT NULL"
        nights SMALLINT "GEN; NOT NULL"
        price_per_night BIGINT "NOT NULL"
        total_amount BIGINT "NOT NULL"
        currency CHAR "length 3; NOT NULL"
        status VARCHAR "length 24; NOT NULL"
        payment_status VARCHAR "length 20; NOT NULL"
        hold_expires_at TIMESTAMPTZ "NULL"
        cancelled_at TIMESTAMPTZ "NULL"
        cancellation_reason VARCHAR "length 500; NULL"
        checked_in_at TIMESTAMPTZ "NULL"
        checked_out_at TIMESTAMPTZ "NULL"
        no_show_at TIMESTAMPTZ "NULL"
        created_at TIMESTAMPTZ "NOT NULL"
        created_by UUID FK "NOT NULL; references audit_actors.id"
        updated_at TIMESTAMPTZ "NOT NULL"
        updated_by UUID FK "NOT NULL; references audit_actors.id"
        is_active BOOLEAN "NOT NULL; default TRUE"
    }

    payment_orders {
        id UUID PK "NOT NULL"
        booking_id UUID FK, UK "NOT NULL; references bookings.id"
        razorpay_order_id VARCHAR UK "length 100; NULL"
        provider VARCHAR "length 16; NOT NULL"
        mode VARCHAR "length 8; NOT NULL"
        amount BIGINT "NOT NULL"
        currency CHAR "length 3; NOT NULL"
        creation_status VARCHAR "length 16; NOT NULL"
        status VARCHAR "length 8; NOT NULL"
        correlation_key VARCHAR UK "length 100; NOT NULL"
        attempt_count INTEGER "NOT NULL"
        next_attempt_at TIMESTAMPTZ "NULL"
        locked_until TIMESTAMPTZ "NULL"
        last_error_code VARCHAR "length 100; NULL"
        reconciled_at TIMESTAMPTZ "NULL"
        created_at TIMESTAMPTZ "NOT NULL"
        created_by UUID FK "NOT NULL; references audit_actors.id"
        updated_at TIMESTAMPTZ "NOT NULL"
        updated_by UUID FK "NOT NULL; references audit_actors.id"
        is_active BOOLEAN "NOT NULL; default TRUE"
    }

    payments {
        id UUID PK "NOT NULL"
        payment_order_id UUID FK "NOT NULL; references payment_orders.id"
        razorpay_payment_id VARCHAR UK "length 100; NOT NULL"
        amount BIGINT "NOT NULL"
        currency CHAR "length 3; NOT NULL"
        status VARCHAR "length 16; NOT NULL"
        failure_code VARCHAR "length 100; NULL"
        failure_message TEXT "NULL"
        authorized_at TIMESTAMPTZ "NULL"
        captured_at TIMESTAMPTZ "NULL"
        verified_at TIMESTAMPTZ "NULL"
        booking_applied_at TIMESTAMPTZ "NULL"
        created_at TIMESTAMPTZ "NOT NULL"
        created_by UUID FK "NOT NULL; references audit_actors.id"
        updated_at TIMESTAMPTZ "NOT NULL"
        updated_by UUID FK "NOT NULL; references audit_actors.id"
        is_active BOOLEAN "NOT NULL; default TRUE"
    }

    refunds {
        id UUID PK "NOT NULL"
        payment_id UUID FK, UK "NOT NULL; references payments.id"
        razorpay_refund_id VARCHAR UK "length 100; NULL"
        amount BIGINT "NOT NULL"
        currency CHAR "length 3; NOT NULL"
        status VARCHAR "length 12; NOT NULL"
        reason VARCHAR "length 500; NOT NULL"
        attempt_count INTEGER "NOT NULL"
        provider_outcome_unknown BOOLEAN "NOT NULL"
        next_attempt_at TIMESTAMPTZ "NULL"
        locked_until TIMESTAMPTZ "NULL"
        last_error_code VARCHAR "length 100; NULL"
        processed_at TIMESTAMPTZ "NULL"
        created_at TIMESTAMPTZ "NOT NULL"
        created_by UUID FK "NOT NULL; references audit_actors.id"
        updated_at TIMESTAMPTZ "NOT NULL"
        updated_by UUID FK "NOT NULL; references audit_actors.id"
        is_active BOOLEAN "NOT NULL; default TRUE"
    }

    webhook_events {
        id UUID PK "NOT NULL"
        provider_event_id VARCHAR UK "length 150; NOT NULL"
        event_type VARCHAR "length 100; NOT NULL"
        payload JSONB "NOT NULL"
        payload_hash CHAR "length 64; NOT NULL"
        status VARCHAR "length 16; NOT NULL"
        attempt_count INTEGER "NOT NULL"
        next_attempt_at TIMESTAMPTZ "NULL"
        locked_until TIMESTAMPTZ "NULL"
        last_error TEXT "NULL"
        processed_at TIMESTAMPTZ "NULL"
        created_at TIMESTAMPTZ "NOT NULL"
        created_by UUID FK "NOT NULL; references audit_actors.id"
        updated_at TIMESTAMPTZ "NOT NULL"
        updated_by UUID FK "NOT NULL; references audit_actors.id"
        is_active BOOLEAN "NOT NULL; default TRUE"
    }

    email_outbox {
        id UUID PK "NOT NULL"
        recipient_user_id UUID FK "NULL; references users.id"
        recipient_email VARCHAR "length 254; NOT NULL"
        booking_id UUID FK "NULL; references bookings.id"
        password_reset_token_id UUID FK "NULL; references password_reset_tokens.id"
        template_code VARCHAR "length 50; NOT NULL"
        template_version INTEGER "NOT NULL"
        template_data JSONB "NOT NULL"
        sensitive_payload_ciphertext BYTEA "NULL"
        encryption_key_id VARCHAR "length 100; NULL"
        deduplication_key VARCHAR UK "length 150; NOT NULL"
        status VARCHAR "length 16; NOT NULL"
        attempt_count INTEGER "NOT NULL"
        available_at TIMESTAMPTZ "NOT NULL"
        locked_until TIMESTAMPTZ "NULL"
        provider_message_id VARCHAR "length 150; NULL"
        last_error TEXT "NULL"
        sent_at TIMESTAMPTZ "NULL"
        created_at TIMESTAMPTZ "NOT NULL"
        created_by UUID FK "NOT NULL; references audit_actors.id"
        updated_at TIMESTAMPTZ "NOT NULL"
        updated_by UUID FK "NOT NULL; references audit_actors.id"
        is_active BOOLEAN "NOT NULL; default TRUE"
    }

    idempotency_records {
        id UUID PK "NOT NULL"
        user_id UUID FK "NOT NULL; references users.id"
        operation VARCHAR "length 200; NOT NULL"
        idempotency_key VARCHAR "length 128; NOT NULL"
        request_hash CHAR "length 64; NOT NULL"
        status VARCHAR "length 16; NOT NULL"
        response_http_code SMALLINT "NULL"
        response_business_body JSONB "NULL"
        resource_id UUID "NULL"
        expires_at TIMESTAMPTZ "NOT NULL"
        locked_until TIMESTAMPTZ "NULL"
        created_at TIMESTAMPTZ "NOT NULL"
        created_by UUID FK "NOT NULL; references audit_actors.id"
        updated_at TIMESTAMPTZ "NOT NULL"
        updated_by UUID FK "NOT NULL; references audit_actors.id"
        is_active BOOLEAN "NOT NULL; default TRUE"
    }

    audit_logs {
        id UUID PK "NOT NULL"
        actor_id UUID FK "NOT NULL; references audit_actors.id"
        action VARCHAR "length 100; NOT NULL"
        entity_type VARCHAR "length 50; NOT NULL"
        entity_id UUID "NOT NULL"
        changes JSONB "NOT NULL"
        request_id VARCHAR "length 100; NULL"
        created_at TIMESTAMPTZ "NOT NULL"
        created_by UUID FK "NOT NULL; references audit_actors.id"
        updated_at TIMESTAMPTZ "NOT NULL"
        updated_by UUID FK "NOT NULL; references audit_actors.id"
        is_active BOOLEAN "NOT NULL; default TRUE"
    }

    audit_actors ||--o| users : "identifies account"
    users ||--o{ hotels : "owns"
    users ||--o{ refresh_sessions : "has login tokens"
    refresh_sessions |o--o| refresh_sessions : "replaced by"
    users ||--o{ password_reset_tokens : "requests password reset"
    hotels ||--o{ hotel_room_types : "offers"
    room_type_master ||--o{ hotel_room_types : "categorizes"
    hotels ||--o{ rooms : "contains"
    hotel_room_types ||--o{ rooms : "classifies"
    users ||--o{ bookings : "makes booking"
    hotels ||--o{ bookings : "receives booking"
    hotel_room_types ||--o{ bookings : "selected for"
    rooms ||--o{ bookings : "allocated to"
    bookings ||--o| payment_orders : "has checkout order"
    payment_orders ||--o{ payments : "has payment attempts"
    payments ||--o| refunds : "has full refund"
    users ||--o{ idempotency_records : "submits request"
    users |o--o{ email_outbox : "receives email"
    bookings |o--o{ email_outbox : "triggers notification"
    password_reset_tokens |o--o{ email_outbox : "triggers reset email"
    audit_actors ||--o{ audit_logs : "performs action"
